---
import { BUILD_TIME, SITE } from '../lib/site';

const buildLabel = BUILD_TIME.slice(0, 19).replace('T', ' ') + ' UTC';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <strong>{SITE.name}</strong>
      <p>Observation-centered runtime safety for enterprise AI.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/">Product</a>
      <a href="/Open-Standards">Open Standards</a>
      <a href="/Open-Standards/Charter">Charter</a>
      <a href="/developer">Developers</a>
      <a href="/resources">Resources</a>
      <a href="/enterprise">Enterprise</a>
      <a href="/enterprise#demo">Contact</a>
      <a href={SITE.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/search">Search</a>
    </nav>

    <dl class="footer-meta" aria-label="Release metadata">
      <div>
        <dt>Site Version</dt>
        <dd>v{SITE.version} · {SITE.channel}</dd>
      </div>
      <div>
        <dt>Last Build</dt>
        <dd><time datetime={BUILD_TIME}>{buildLabel}</time></dd>
      </div>
      <div>
        <dt>Company</dt>
        <dd>{SITE.orgLegal}</dd>
      </div>
      <div>
        <dt>License</dt>
        <dd>
          <a href={SITE.licenseUrl}>{SITE.licenseLabel}</a>
        </dd>
      </div>
    </dl>

    <p class="copyright">
      {SITE.copyright}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .footer-inner {
    width: min(100% - 2rem, var(--content-max));
    margin-inline: auto;
    padding: var(--space-6) 0;
    display: grid;
    gap: var(--space-4);
  }

  .footer-brand p {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-meta {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .footer-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .footer-meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .footer-meta > div {
    display: grid;
    gap: 0.2rem;
  }

  .footer-meta dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .footer-meta dd {
    margin: 0;
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-size: 0.875rem;
  }

  .copyright {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
</style>
