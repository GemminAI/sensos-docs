---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const platforms = ['OpenAI', 'Anthropic', 'Gemini', 'Llama', 'Mistral', 'Qwen', 'Local Models'];

const benefits = [
  {
    title: 'Enterprise Safety',
    body: 'Continuous runtime oversight for production AI — beyond prompt filters and output scanners.',
  },
  {
    title: 'Model Agnostic',
    body: 'Works with the models you already run. No weight changes required.',
  },
  {
    title: 'Auditable',
    body: 'Durable evidence of observation, authorization, and intervention decisions.',
  },
  {
    title: 'Low Latency',
    body: 'Designed for online inference paths where delayed safety is failed safety.',
  },
  {
    title: 'Works with Existing Models',
    body: 'Observe and control behavior without retraining or replacing your stack.',
  },
];

const resources = [
  { href: '/resources#whitepaper', title: 'Whitepaper', body: 'Observation-first AI safety for enterprise leaders.' },
  { href: '/developer', title: 'Developer Docs', body: 'Integrate against public interfaces and conformance tiers.' },
  { href: '/rfc', title: 'Public RFCs', body: 'Open standards for interoperability — not implementation manuals.' },
  { href: '/resources#case-studies', title: 'Case Studies', body: 'Production patterns for platform and risk teams.' },
  { href: '/resources#research', title: 'Research', body: 'Selected public research and standards notes.' },
];
---

<BaseLayout
  title="Observation-Centered Runtime Safety"
  description={SITE.description}
>
  <header class="page-header home-header">
    <p class="eyebrow">Enterprise AI Runtime Safety</p>
    <h1>
      Observation First.<br />
      True AI Safety.<br />
      Without Changing Your Model.
    </h1>
    <p class="lede">
      SensOS continuously observes AI runtime behavior, detects semantic trajectory risks,
      and safely controls AI systems without modifying model weights.
    </p>
    <div class="btn-row" style="margin-top: 1.25rem;">
      <a class="btn btn-primary" href="/enterprise#demo">Request Demo</a>
      <a class="btn" href="/resources#whitepaper">Read Whitepaper</a>
    </div>
  </header>

  <section class="home-section" aria-labelledby="problem-heading">
    <h2 id="problem-heading">The Problem</h2>
    <p>Today's AI systems are black boxes.</p>
    <ul class="home-list">
      <li>Prompt engineering cannot monitor hidden runtime behavior.</li>
      <li>RLHF cannot protect production inference.</li>
      <li>Current guardrails only inspect inputs and outputs.</li>
    </ul>
  </section>

  <section class="home-section" aria-labelledby="solution-heading">
    <h2 id="solution-heading">The Solution</h2>
    <p>
      SensOS is an Observation-Centered Runtime Safety Platform.
    </p>
    <p>
      Instead of modifying models, SensOS observes semantic trajectories,
      predicts instability, and intervenes before unsafe behavior emerges.
    </p>
  </section>

  <section class="home-section" aria-labelledby="how-heading">
    <h2 id="how-heading">How It Works</h2>
    <p>Three steps. No implementation theater.</p>
    <div class="card-grid how-grid">
      <div class="panel panel-pad home-card static">
        <h3>Observe</h3>
        <p>Continuously watch runtime behavior as it unfolds.</p>
      </div>
      <div class="panel panel-pad home-card static">
        <h3>Understand</h3>
        <p>Detect semantic trajectory risk before harm reaches users.</p>
      </div>
      <div class="panel panel-pad home-card static">
        <h3>Control</h3>
        <p>Intervene safely — without changing model weights.</p>
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="benefits-heading">
    <h2 id="benefits-heading">Benefits</h2>
    <div class="card-grid">
      {
        benefits.map((item) => (
          <div class="panel panel-pad home-card static">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section" aria-labelledby="platforms-heading">
    <h2 id="platforms-heading">Supported Platforms</h2>
    <p>Model-agnostic by design.</p>
    <ul class="platform-row" aria-label="Supported platforms">
      {platforms.map((name) => <li>{name}</li>)}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="standards-heading">
    <h2 id="standards-heading">Open Standards</h2>
    <p>
      SensOS publishes interface standards — not implementation.
    </p>
    <p>
      Public RFCs describe interoperability, conformance, ABI, and behavior.
      They do not disclose algorithms, kernels, or proprietary execution methods.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/rfc">Browse Public RFCs</a>
      <a class="btn" href="/developer">Developer Docs</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="resources-heading">
    <h2 id="resources-heading">Resources</h2>
    <div class="card-grid">
      {
        resources.map((item) => (
          <a class="panel panel-pad home-card" href={item.href}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    margin-bottom: var(--space-7);
  }

  .home-section > h2 {
    margin: 0 0 var(--space-3);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .home-section > p {
    margin: 0 0 var(--space-4);
    max-width: 48rem;
    color: var(--color-text-muted);
  }

  .home-list {
    margin: 0;
    padding-left: 1.2rem;
    max-width: 48rem;
    color: var(--color-text-muted);
    display: grid;
    gap: 0.55rem;
  }

  .card-grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .how-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .card-grid:not(.how-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .home-card {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: 0.45rem;
  }

  .home-card:not(.static):hover {
    border-color: var(--color-accent);
  }

  .home-card h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .home-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .platform-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .platform-row li {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
