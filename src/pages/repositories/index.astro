---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REPOSITORIES, getGraphProvider, graphPageHref } from '../../lib/graph';

const provider = await getGraphProvider();
---

<BaseLayout
  title="Repositories"
  description="SensOS ecosystem repositories with GraphProvider-backed relationships."
>
  <header class="page-header">
    <p class="eyebrow">Ecosystem</p>
    <h1>Repositories</h1>
    <p>
      Canonical repository identities for SensOS. Each page surfaces implemented RFCs,
      dependencies, related products, and a Graph view.
    </p>
  </header>

  <div class="repo-grid">
    {
      await Promise.all(
        REPOSITORIES.map(async (repo) => {
          const node = await provider.getNode(repo.id);
          return (
            <a class="panel panel-pad repo-card" href={`/repositories/${repo.slug}`}>
              <h2>{repo.name}</h2>
              <code>{repo.id}</code>
              <p>{repo.overview}</p>
              <span class="status-pill status-active">
                {node?.implementationStatus ?? 'Active'}
              </span>
            </a>
          );
        }),
      )
    }
  </div>

  <p class="footer-note">
    <a href={graphPageHref({ view: 'repository' })}>Open Repository Graph →</a>
  </p>
</BaseLayout>

<style>
  .repo-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 800px) {
    .repo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .repo-card {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: var(--space-2);
  }

  .repo-card:hover {
    border-color: var(--color-accent);
  }

  h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .footer-note {
    margin-top: var(--space-5);
  }
</style>
