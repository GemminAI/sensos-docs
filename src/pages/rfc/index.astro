---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RfcTable from '../../components/RfcTable.astro';
import { getAllRfcs } from '../../lib/rfc';

const rfcs = await getAllRfcs();
---

<BaseLayout
  title="RFC Series"
  description="Index of SensOS RFCs with status, category, version, and repository provenance."
>
  <header class="page-header">
    <p class="eyebrow">Specifications</p>
    <h1>RFC Series</h1>
    <p>
      Normative and procedural specifications for the SensOS ecosystem. Each
      entry opens a dedicated page with metadata, rendered content, and
      navigation to related RFCs.
    </p>
  </header>

  <p class="index-note">
    Machine-readable feed:
    <a href="/api/v1/rfc.json"><code>/api/v1/rfc.json</code></a>
    · {rfcs.length} published documents
  </p>

  <RfcTable rfcs={rfcs} />
</BaseLayout>

<style>
  .index-note {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
