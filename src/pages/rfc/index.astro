---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RfcTable from '../../components/RfcTable.astro';
import { getAllRfcs } from '../../lib/rfc';

const rfcs = await getAllRfcs();
---

<BaseLayout
  title="Open Standards"
  description="Public SensOS RFCs: interoperability, ABI, behavior, and conformance — not implementation manuals."
>
  <header class="page-header">
    <p class="eyebrow">Open Standards</p>
    <h1>Public RFCs</h1>
    <p>
      SensOS publishes interface standards. These documents describe
      interoperability, ABI, observable behavior, and conformance.
      They do not disclose algorithms, wire secrets, or proprietary execution methods.
    </p>
  </header>

  <p class="index-note">
    Machine-readable feed:
    <a href="/api/v1/rfc.json"><code>/api/v1/rfc.json</code></a>
    · {rfcs.length} public documents
    · <a href="/developer">RFC philosophy</a>
  </p>

  <RfcTable rfcs={rfcs} />
</BaseLayout>

<style>
  .index-note {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
